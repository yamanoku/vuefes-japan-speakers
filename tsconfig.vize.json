{
  "extends": "./tsconfig.json",
  "contentMappers": [{ "package": "vize", "extensions": [".vue"] }],
  "include": [
    "./env.d.ts",
    "./vite.config.ts",
    "./src/**/*.ts",
    "./src/**/*.vue",
    "./src/data/**/*.ts",
    "./musea/**/*.ts",
    "./types/**/*.ts",
    "./config/**/*.ts",
    "./vitest.mutator.config.ts",
    "./mutator.config.ts",
    "./mutator.playwright.config.ts",
    "./playwright.config.ts",
    "./e2e/**/*.ts"
  ],
  "exclude": [
    "./src/**/*.test.ts",
    "./src/data/**/*.test.ts",
    "./node_modules",
    "./.cache",
    "./dist"
  ]
}
